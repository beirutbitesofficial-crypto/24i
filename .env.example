DATABASE_URL="postgresql://postgres:postgres@localhost:5432/production24i"
SESSION_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="24i-production"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
CRON_SECRET="replace-me"

BUFFER_API_KEY=""
ADMIN_RESET_PASSWORD="false"

# AI script writer (Scripts page). Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Optional: which model to use (default gpt-4o-mini)
OPENAI_MODEL=""

# ---- Public website (/website) ----
# Contact and booking form delivery (Resend email and/or a JSON webhook).
RESEND_API_KEY=""
FORM_TO_EMAIL="24iprd@gmail.com"
FORM_FROM_EMAIL=""
FORM_WEBHOOK_URL=""
# Optional Cal.com / Calendly embed URL for "Book a Meeting".
NEXT_PUBLIC_BOOKING_URL=""
# Studio details are built in (src/lib/website/site.ts); these only override them.
NEXT_PUBLIC_SITE_URL="https://24iproduction.com"

# ---- Website meeting bookings → WhatsApp (optional, WhatsApp Cloud API by Meta) ----
# Without these, managers still get in-app + push notifications and a one-tap
# "WhatsApp client" button in /meetings that opens WhatsApp with the message ready.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Manager number that receives new requests (default +96171364090).
MEETINGS_WHATSAPP_TO=""
# Approved message templates (needed for messages outside a 24h chat window).
# meeting request params: {{1}} name, {{2}} topic, {{3}} date+time, {{4}} format, {{5}} phone
WHATSAPP_TEMPLATE_MANAGER=""
# confirmed params: {{1}} name, {{2}} date+time, {{3}} format · declined params: {{1}} name, {{2}} date+time
WHATSAPP_TEMPLATE_CONFIRMED=""
WHATSAPP_TEMPLATE_DECLINED=""
WHATSAPP_TEMPLATE_LANG="en"
