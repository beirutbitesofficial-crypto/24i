# Public site details (shown on the page). Leave blank to hide a field.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_ADDRESS=Beirut, Lebanon
NEXT_PUBLIC_MAP_QUERY=Beirut, Lebanon

# Optional scheduling integration (Cal.com / Calendly embed URL).
# When set, "Book a Meeting" embeds it instead of the built-in request form.
NEXT_PUBLIC_BOOKING_URL=

# Form delivery: configure at least one in production.
# Resend (https://resend.com) email delivery
RESEND_API_KEY=
FORM_FROM_EMAIL=24i Website <website@yourdomain.com>
FORM_TO_EMAIL=
# Or any JSON webhook (Zapier, Make, Slack workflow, n8n, ...)
FORM_WEBHOOK_URL=
