generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum Language {
  EN
  AR
}

enum ClientStatus {
  LEAD
  ACTIVE
  PAUSED
  PENDING_PAYMENT
  CONTRACT_ENDING
  INACTIVE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  REVISION
  WAITING_CLIENT
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ContentType {
  STATIC_POST
  CAROUSEL
  REEL
  STORY
  TIKTOK
  YOUTUBE_SHORT
  FACEBOOK_POST
  LINKEDIN_POST
  ADVERTISEMENT
  OTHER
}

enum WorkflowStatus {
  IDEA
  CONTENT_PLAN
  PRODUCTION
  UPLOAD
  WAITING_CLIENT_APPROVAL
  CLIENT_REVIEW
  REVISION_REQUESTED
  APPROVED
  CAPTION_APPROVED
  READY_TO_SCHEDULE
  SCHEDULED
  PUBLISHED
}

enum ApprovalState {
  NOT_REQUIRED
  DRAFT
  WAITING
  APPROVED
  REVISION_REQUESTED
}

enum PaymentStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
}

enum TransactionType {
  INVOICE
  PAYMENT
  EXTRA_SERVICE
  EXPENSE
  SALARY
  REVERSAL
}

enum NotificationKind {
  TASK
  DUE
  OVERDUE
  APPROVAL
  REVISION
  READY_TO_SCHEDULE
  PAYMENT
  CONTRACT
  SYSTEM
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  id         String @id @default(cuid())
  roleId     String
  permission String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
}

model User {
  id                      String             @id @default(cuid())
  name                    String
  email                   String             @unique
  passwordHash            String
  phone                   String?
  avatarKey               String?
  roleId                  String
  language                Language           @default(EN)
  notificationPreferences Json               @default("{}")
  status                  AccountStatus      @default(ACTIVE)
  lastLoginAt             DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  role                    Role               @relation(fields: [roleId], references: [id])
  clientUsers             ClientUser[]
  assignments             TaskAssignment[]
  uploads                 ContentVersion[]
  notifications           Notification[]
  pushSubscriptions       PushSubscription[]
  auditLogs               AuditLog[]
}

model Client {
  id              String          @id @default(cuid())
  brandName       String
  logoKey         String?
  industry        String?
  contactName     String
  phone           String?
  whatsapp        String?
  email           String
  website         String?
  instagram       String?
  facebook        String?
  tiktok          String?
  startDate       DateTime?
  contractEndDate DateTime?
  paymentDueDay   Int?
  status          ClientStatus    @default(LEAD)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  users           ClientUser[]
  packages        ClientPackage[]
  projects        Project[]
  tasks           Task[]
  content         ContentItem[]
  invoices        Invoice[]
  expenses        Expense[]
  files           FileObject[]
}

model ClientUser {
  id       String @id @default(cuid())
  clientId String
  userId   String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
}

model Package {
  id             String          @id @default(cuid())
  name           String
  price          Decimal         @db.Decimal(12, 2)
  interval       String          @default("MONTHLY")
  entitlements   Json
  active         Boolean         @default(true)
  clientPackages ClientPackage[]
}

model ClientPackage {
  id        String    @id @default(cuid())
  clientId  String
  packageId String
  startsAt  DateTime
  endsAt    DateTime?
  price     Decimal   @db.Decimal(12, 2)
  usage     Json      @default("{}")
  client    Client    @relation(fields: [clientId], references: [id])
  package   Package   @relation(fields: [packageId], references: [id])

  @@index([clientId, startsAt])
}

model Project {
  id          String        @id @default(cuid())
  clientId    String
  name        String
  description String?
  status      String        @default("ACTIVE")
  client      Client        @relation(fields: [clientId], references: [id])
  tasks       Task[]
  content     ContentItem[]
  files       FileObject[]
  createdAt   DateTime      @default(now())
}

model Task {
  id          String           @id @default(cuid())
  clientId    String?
  projectId   String?
  title       String
  description String?
  category    String
  priority    Priority         @default(MEDIUM)
  startAt     DateTime?
  dueAt       DateTime?
  status      TaskStatus       @default(TODO)
  recurrence  Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  client      Client?          @relation(fields: [clientId], references: [id])
  project     Project?         @relation(fields: [projectId], references: [id])
  assignees   TaskAssignment[]
  comments    TaskComment[]
  files       FileObject[]
}

model TaskAssignment {
  id     String @id @default(cuid())
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model ContentItem {
  id            String           @id @default(cuid())
  clientId      String
  projectId     String?
  title         String
  type          ContentType
  platform      String[]
  status        WorkflowStatus   @default(IDEA)
  visualStatus  ApprovalState    @default(DRAFT)
  captionStatus ApprovalState    @default(DRAFT)
  plannedAt     DateTime?
  publishedAt   DateTime?
  ownerId       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  client        Client           @relation(fields: [clientId], references: [id])
  project       Project?         @relation(fields: [projectId], references: [id])
  versions      ContentVersion[]
  captions      CaptionVersion[]
  approvals     Approval[]
  calendar      CalendarEntry?
  files         FileObject[]

  @@index([clientId, status])
}

model ContentVersion {
  id           String          @id @default(cuid())
  contentId    String
  version      Int
  fileId       String?
  thumbnailId  String?
  notes        String?
  uploadedById String
  createdAt    DateTime        @default(now())
  content      ContentItem     @relation(fields: [contentId], references: [id], onDelete: Cascade)
  uploadedBy   User            @relation(fields: [uploadedById], references: [id])
  slides       CarouselSlide[]
  approvals    Approval[]

  @@unique([contentId, version])
}

model CarouselSlide {
  id        String         @id @default(cuid())
  versionId String
  fileId    String
  position  Int
  version   ContentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  notes     ApprovalNote[]

  @@unique([versionId, position])
}

model CaptionVersion {
  id          String      @id @default(cuid())
  contentId   String
  version     Int
  caption     String
  hashtags    String?
  cta         String?
  createdById String
  createdAt   DateTime    @default(now())
  content     ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  approvals   Approval[]

  @@unique([contentId, version])
}

model Approval {
  id               String          @id @default(cuid())
  contentId        String
  contentVersionId String?
  captionVersionId String?
  reviewerId       String
  state            ApprovalState
  scope            String
  createdAt        DateTime        @default(now())
  decidedAt        DateTime?
  content          ContentItem     @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentVersion   ContentVersion? @relation(fields: [contentVersionId], references: [id])
  captionVersion   CaptionVersion? @relation(fields: [captionVersionId], references: [id])
  notes            ApprovalNote[]

  @@index([contentId, state])
}

model ApprovalNote {
  id         String         @id @default(cuid())
  approvalId String
  authorId   String
  body       String
  slideId    String?
  createdAt  DateTime       @default(now())
  approval   Approval       @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  slide      CarouselSlide? @relation(fields: [slideId], references: [id])
}

model CalendarEntry {
  id               String         @id @default(cuid())
  contentId        String         @unique
  scheduledAt      DateTime
  publishingStatus WorkflowStatus @default(SCHEDULED)
  content          ContentItem    @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  title     String
  body      String
  deepLink  String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FileObject {
  id           String       @id @default(cuid())
  key          String       @unique
  originalName String
  mimeType     String
  size         BigInt
  checksum     String?
  clientId     String?
  projectId    String?
  taskId       String?
  contentId    String?
  uploadedById String
  createdAt    DateTime     @default(now())
  deletedAt    DateTime?
  client       Client?      @relation(fields: [clientId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  task         Task?        @relation(fields: [taskId], references: [id])
  content      ContentItem? @relation(fields: [contentId], references: [id])
}

model Invoice {
  id           String                 @id @default(cuid())
  clientId     String
  number       String                 @unique
  total        Decimal                @db.Decimal(12, 2)
  dueDate      DateTime
  status       PaymentStatus          @default(UNPAID)
  issuedAt     DateTime               @default(now())
  voidedAt     DateTime?
  client       Client                 @relation(fields: [clientId], references: [id])
  payments     Payment[]
  revenueItems RevenueItem[]
  transactions FinancialTransaction[]

  @@index([clientId, status])
}

model Payment {
  id           String   @id @default(cuid())
  invoiceId    String
  amount       Decimal  @db.Decimal(12, 2)
  paidAt       DateTime
  method       String
  reference    String?
  recordedById String
  reversedAt   DateTime?
  invoice      Invoice  @relation(fields: [invoiceId], references: [id])
}

model RevenueItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  amount      Decimal @db.Decimal(12, 2)
  kind        String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model ExpenseCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  active   Boolean   @default(true)
  expenses Expense[]
}

model Expense {
  id            String                 @id @default(cuid())
  description   String
  amount        Decimal                @db.Decimal(12, 2)
  date          DateTime
  categoryId    String
  vendor        String?
  paymentMethod String?
  clientId      String?
  receiptKey    String?
  notes         String?
  createdById   String
  reversedAt    DateTime?
  category      ExpenseCategory        @relation(fields: [categoryId], references: [id])
  client        Client?                @relation(fields: [clientId], references: [id])
  transactions  FinancialTransaction[]
}

model SalaryProfile {
  id         String          @id @default(cuid())
  employeeId String          @unique
  baseSalary Decimal         @db.Decimal(12, 2)
  active     Boolean         @default(true)
  payments   SalaryPayment[]
}

model SalaryPayment {
  id           String                 @id @default(cuid())
  profileId    String
  base         Decimal                @db.Decimal(12, 2)
  bonus        Decimal                @db.Decimal(12, 2)
  deduction    Decimal                @db.Decimal(12, 2)
  advance      Decimal                @db.Decimal(12, 2)
  finalAmount  Decimal                @db.Decimal(12, 2)
  paymentDate  DateTime
  notes        String?
  reversedAt   DateTime?
  profile      SalaryProfile          @relation(fields: [profileId], references: [id])
  transactions FinancialTransaction[]
}

model FinancialTransaction {
  id              String         @id @default(cuid())
  type            TransactionType
  amount          Decimal        @db.Decimal(12, 2)
  invoiceId       String?
  expenseId       String?
  salaryPaymentId String?
  reversalOfId    String?
  createdById     String
  createdAt       DateTime       @default(now())
  metadata        Json           @default("{}")
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id])
  expense         Expense?       @relation(fields: [expenseId], references: [id])
  salaryPayment   SalaryPayment? @relation(fields: [salaryPaymentId], references: [id])

  @@index([type, createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId, createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
